# ─── Таймауты и лимиты аудио ─────────────────────────────────────────────────
# Таймаут скачивания аудио (мс)
AUDIO_FETCH_TIMEOUT_MS=60000

# Максимальный размер аудиофайла (байты). 8 МБ достаточно для ~1–2 мин речи
MAX_AUDIO_BYTES=8388608

# Максимальная длительность аудио (секунды). Рекомендуется 90 для сообщений до 1 минуты
MAX_AUDIO_DURATION_SEC=90

# Максимальная длина текста транскрипции (символы). ~2000 ≈ 400–500 токенов
MAX_OUTPUT_CHARS=2000

# Таймаут запроса к API транскрибации (мс)
API_TIMEOUT_MS=120000

# ─── Ограничения нагрузки ────────────────────────────────────────────────────
# Максимум одновременных транскрибаций
MAX_CONCURRENT=5

# Максимум запросов с одного IP в минуту
RATE_LIMIT_PER_MIN=30

# ─── API транскрибации (Whisper-совместимый) ──────────────────────────────────
# Базовый URL API (без завершающего слэша)
TRANSCRIPTION_API_BASE=https://example.com/api/v1

# API-ключ
TRANSCRIPTION_API_KEY=sk-...

# Модель транскрибации
TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo

# Опциональный промпт для Whisper (подсказка по языкам, именам, терминам).
# Передаётся как параметр prompt — помогает с орфографией и смешанной речью.
TRANSCRIPTION_PROMPT=Текст может содержать русский и английский языки, технические термины, названия сервисов и имена. Сохраняй оригинальный язык каждого слова, не переводи.

# ─── Опциональная коррекция текста второй моделью ────────────────────────────
# Включить постобработку распознанного текста (true/false)
CORRECTION_ENABLED=false

# Базовый URL API коррекции (OpenAI-совместимый /chat/completions)
CORRECTION_API_BASE=https://example.com/api/v1

# API-ключ для модели коррекции
CORRECTION_API_KEY=sk-...

# Модель коррекции (достаточно небольшой и быстрой)
CORRECTION_MODEL=openai/gpt-4o-mini

# Таймаут запроса коррекции (мс)
CORRECTION_TIMEOUT_MS=30000

# Системный промпт для исправления ошибок распознавания (исправление ошибок ASR).
# Цели: исправить ошибки, добавить пунктуацию и абзацы, убрать слова-паразиты
# и галлюцинации вроде «Субтитры создавал DimaTorzok», сохранить смесь ru/en.
CORRECTION_PROMPT=Ты — редактор текста из распознавания речи. Исправь ошибки распознавания, орфографию и пунктуацию. Разбей текст на предложения и абзацы по смыслу. Убери слова-паразиты, междометия и повторы, если они не несут смысла. Обязательно удали служебные фразы и «водяные знаки» вроде «Субтитры создавал DimaTorzok», «Subtitles by …» и подобные. Сохрани смысл и стиль оригинала. Текст может содержать смесь русского и английского — не переводи слова с одного языка на другой. Не добавляй ничего от себя. Верни только исправленный текст без пояснений и кавычек.

# ─── Сервер ──────────────────────────────────────────────────────────────────
PORT=8080

# Уровень логов: debug | info | warn | error
LOG_LEVEL=info

# ─── Опционально ─────────────────────────────────────────────────────────────
# Внутренний базовый URL для скачивания аудио.
# Если задан — origin входящего URL  заменяется на этот адрес,
# путь и query сохраняются. Позволяет ходить за файлами по локальной docker-сети.
# Пример: http://yougile:8001
# INTERNAL_AUDIO_BASE=http://yougile:8001

# Белый список хостов для скачивания аудио (через запятую).
# Если пусто — разрешены любые хосты.
# Проверка выполняется УЖЕ после подмены на INTERNAL_AUDIO_BASE (если она есть).
#
# Для Docker-сети / внутренней сети:
#   ALLOWED_HOSTS=yougile,task.example.com
#
# ALLOWED_HOSTS=yougile

